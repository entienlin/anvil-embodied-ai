{
    "dataset": {
        "repo_id": "SSTC-AITeam/hilserl-push-bottle",
        "root": "/tmp/push_bottle_demos",
        "episodes": null,
        "image_transforms": {
            "enable": false,
            "max_num_transforms": 3,
            "random_order": false,
            "tfs": {
                "brightness": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "brightness": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "contrast": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "contrast": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "saturation": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "saturation": [
                            0.5,
                            1.5
                        ]
                    }
                },
                "hue": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "hue": [
                            -0.05,
                            0.05
                        ]
                    }
                },
                "sharpness": {
                    "weight": 1.0,
                    "type": "SharpnessJitter",
                    "kwargs": {
                        "sharpness": [
                            0.5,
                            1.5
                        ]
                    }
                },
                "affine": {
                    "weight": 1.0,
                    "type": "RandomAffine",
                    "kwargs": {
                        "degrees": [
                            -5.0,
                            5.0
                        ],
                        "translate": [
                            0.05,
                            0.05
                        ]
                    }
                }
            }
        },
        "revision": null,
        "use_imagenet_stats": true,
        "video_backend": "pyav",
        "streaming": false
    },
    "env": {
        "type": "gym_manipulator",
        "task": null,
        "fps": 10,
        "features": {
            "state": {
                "type": "STATE",
                "shape": [
                    7
                ]
            },
            "wrist_r_image": {
                "type": "VISUAL",
                "shape": [
                    128,
                    128,
                    3
                ]
            },
            "ee_delta_action": {
                "type": "ACTION",
                "shape": [
                    3
                ]
            }
        },
        "features_map": {
            "state": "observation.state",
            "wrist_r_image": "observation.images.wrist_r",
            "ee_delta_action": "action"
        },
        "max_parallel_tasks": 1,
        "disable_env_checker": true,
        "robot": {
            "type": "anvil_openarm_follower",
            "id": null,
            "calibration_dir": null,
            "ros_prefix": "follower_r",
            "joint_state_topic": "/joint_states",
            "command_topic": "/follower_r_forward_position_controller/commands",
            "num_joints": 7,
            "camera_topics": {
                "wrist_r": "/cam_wrist_r/image_raw/compressed"
            },
            "control_frequency": 10.0,
            "max_position_delta": 0.05,
            "max_command_step_rad": 0.03,
            "obs_timeout_s": 2.0
        },
        "teleop": {
            "type": "anvil_openarm_leader",
            "id": null,
            "calibration_dir": null,
            "ros_prefix": "leader_r",
            "joint_state_topic": "/joint_states",
            "num_joints": 7,
            "urdf_path": "configs/hilserl/urdf/openarm_teleop_kinematics.urdf",
            "target_frame_name": "leader_r_hand_tcp",
            "step_sizes": {
                "x": 0.02,
                "y": 0.02,
                "z": 0.02
            },
            "obs_timeout_s": 2.0,
            "policy_controller": "follower_r_forward_position_controller",
            "teleop_controller": "teleop_controller",
            "follower_command_topic": "/follower_r_forward_position_controller/commands",
            "follower_joint_prefix": "follower_r"
        },
        "processor": {
            "control_mode": "leader",
            "observation": {
                "add_joint_velocity_to_observation": false,
                "add_current_to_observation": false,
                "add_ee_pose_to_observation": false,
                "display_cameras": false
            },
            "image_preprocessing": {
                "crop_params_dict": {},
                "resize_size": [
                    128,
                    128
                ]
            },
            "gripper": {
                "use_gripper": false,
                "gripper_penalty": 0.0
            },
            "reset": {
                "fixed_reset_joint_positions": null,
                "reset_time_s": 18.0,
                "control_time_s": 20.0,
                "terminate_on_success": true
            },
            "inverse_kinematics": {
                "urdf_path": "configs/hilserl/urdf/openarm_teleop_kinematics.urdf",
                "target_frame_name": "follower_r_hand_tcp",
                "end_effector_bounds": {
                    "min": [
                        -0.0247,
                        -0.4427,
                        0.1117
                    ],
                    "max": [
                        0.4159,
                        0.0418,
                        0.309
                    ]
                },
                "end_effector_step_sizes": {
                    "x": 0.02,
                    "y": 0.02,
                    "z": 0.02
                }
            },
            "reward_classifier": null,
            "max_gripper_pos": 100.0
        },
        "name": "real_robot"
    },
    "policy": {
        "type": "sac",
        "n_obs_steps": 1,
        "input_features": {
            "observation.state": {
                "type": "STATE",
                "shape": [
                    7
                ]
            },
            "observation.images.wrist_r": {
                "type": "VISUAL",
                "shape": [
                    3,
                    128,
                    128
                ]
            }
        },
        "output_features": {
            "action": {
                "type": "ACTION",
                "shape": [
                    3
                ]
            }
        },
        "device": "cuda",
        "use_amp": false,
        "use_peft": false,
        "push_to_hub": false,
        "repo_id": null,
        "private": null,
        "tags": null,
        "license": null,
        "pretrained_path": "/workspace/configs/hilserl/rl_ckpt_0923_step4000",
        "normalization_mapping": {
            "VISUAL": "MEAN_STD",
            "STATE": "MIN_MAX",
            "ENV": "MIN_MAX",
            "ACTION": "MIN_MAX"
        },
        "dataset_stats": {
            "observation.image": {
                "mean": [
                    0.485,
                    0.456,
                    0.406
                ],
                "std": [
                    0.229,
                    0.224,
                    0.225
                ]
            },
            "observation.state": {
                "min": [
                    0.0,
                    0.0
                ],
                "max": [
                    1.0,
                    1.0
                ]
            },
            "action": {
                "min": [
                    0.0,
                    0.0,
                    0.0
                ],
                "max": [
                    1.0,
                    1.0,
                    1.0
                ]
            }
        },
        "storage_device": "cpu",
        "vision_encoder_name": "/workspace/configs/hilserl/resnet10",
        "freeze_vision_encoder": true,
        "image_encoder_hidden_dim": 32,
        "shared_encoder": true,
        "num_discrete_actions": null,
        "image_embedding_pooling_dim": 8,
        "online_steps": 4000,
        "online_buffer_capacity": 2000,
        "offline_buffer_capacity": 2000,
        "async_prefetch": false,
        "online_step_before_learning": 10,
        "policy_update_freq": 1,
        "discount": 0.99,
        "temperature_init": 0.01,
        "num_critics": 2,
        "num_subsample_critics": null,
        "critic_lr": 0.0003,
        "actor_lr": 0.0003,
        "temperature_lr": 0.0003,
        "critic_target_update_weight": 0.005,
        "utd_ratio": 1,
        "state_encoder_hidden_dim": 256,
        "latent_dim": 256,
        "target_entropy": null,
        "use_backup_entropy": true,
        "grad_clip_norm": 40.0,
        "critic_network_kwargs": {
            "hidden_dims": [
                256,
                256
            ],
            "activate_final": true,
            "final_activation": null
        },
        "actor_network_kwargs": {
            "hidden_dims": [
                256,
                256
            ],
            "activate_final": true
        },
        "policy_kwargs": {
            "use_tanh_squash": true,
            "std_min": 1e-05,
            "std_max": 0.5,
            "init_final": 0.05
        },
        "discrete_critic_network_kwargs": {
            "hidden_dims": [
                256,
                256
            ],
            "activate_final": true,
            "final_activation": null
        },
        "actor_learner_config": {
            "learner_host": "127.0.0.1",
            "learner_port": 50051,
            "policy_parameters_push_frequency": 4,
            "queue_get_timeout": 2
        },
        "concurrency": {
            "actor": "threads",
            "learner": "threads"
        },
        "use_torch_compile": false
    },
    "output_dir": "outputs/hilserl_push_bottle",
    "job_name": "hilserl_push_bottle",
    "resume": false,
    "seed": 42,
    "cudnn_deterministic": false,
    "num_workers": 4,
    "batch_size": 8,
    "steps": 100000,
    "eval_freq": 20000,
    "log_freq": 200,
    "tolerance_s": 0.0001,
    "save_checkpoint": true,
    "save_freq": 250,
    "use_policy_training_preset": true,
    "optimizer": {
        "type": "multi_adam",
        "lr": 0.001,
        "weight_decay": 0.0,
        "grad_clip_norm": 10.0,
        "optimizer_groups": {
            "actor": {
                "lr": 0.0003
            },
            "critic": {
                "lr": 0.0003
            },
            "temperature": {
                "lr": 0.0003
            }
        }
    },
    "scheduler": null,
    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },
    "wandb": {
        "enable": false,
        "disable_artifact": false,
        "project": "lerobot",
        "entity": null,
        "notes": null,
        "run_id": null,
        "mode": null,
        "add_tags": true
    },
    "peft": null,
    "use_rabc": false,
    "rabc_progress_path": null,
    "rabc_kappa": 0.01,
    "rabc_epsilon": 1e-06,
    "rabc_head_mode": "sparse",
    "rename_map": {},
    "checkpoint_path": null
}